{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "terminal.integrated.scrollback": 10000,
  "typescript.surveys.enabled": false,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSaveMode": "file",
  "mayank1513.trello-kanban.Workspace.filePath": ".tkb",
  "cSpell.words": ["noscss"],
  "conventionalCommits.scopes": [
    "@app/web",
    "@m2d/cache",
    "@m2d/cli",
    "@m2d/core",
    "@m2d/frontmatter",
    "@m2d/html",
    "@m2d/html-node",
    "@m2d/image",
    "@m2d/image-node",
    "@m2d/list",
    "@m2d/math",
    "@m2d/md2docx",
    "@m2d/mdast",
    "@m2d/mermaid",
    "@m2d/mermaid-node",
    "@m2d/react-markdown",
    "@m2d/remark-docx",
    "@m2d/remark-docx-node",
    "@m2d/table",
    "@m2d/tiptap",
    "@tool/scripts",
    "@tool/tsconfig",
    "mdast2docx"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  }
}
