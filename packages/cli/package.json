{
  "name": "@m2d/cli",
  "author": "Mayank Kumar Chaudhari <https://mayankchaudhari.com>",
  "private": false,
  "version": "0.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Command-line interface and programmatic Node.js engine for Markdown to DOCX conversion.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/md2docx/md2docx",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/md2docx/md2docx/issues",
  "homepage": "https://github.com/md2docx/md2docx/blob/main/packages/cli/README.md",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "bin": {
    "cli": "./dist/cli.mjs",
    "m2d": "./dist/cli.mjs",
    "md2docx": "./dist/cli.mjs",
    "md2docx-node": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@m2d/core": "workspace:*",
    "@m2d/remark-docx-node": "workspace:*",
    "@turboforge/cli-kit": "latest",
    "docx": "^9.12.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsup": "latest",
    "typescript": "latest"
  },
  "forge": {
    "aliases": [
      "@md2docx/cli",
      "@mdast2docx/cli",
      "@m2d/md2docx-node",
      "@md2docx/md2docx-node",
      "@mdast2docx/md2docx-node",
      "md2docx-node"
    ],
    "icon": "Terminal",
    "description": "Command-line interface and programmatic Node.js engine for Markdown to DOCX conversion"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/md2docx"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/mayank1513"
    }
  ],
  "keywords": [
    "@m2d/cli",
    "@m2d/md2docx-node",
    "md2docx-node",
    "cli",
    "markdown-to-docx",
    "turboforge"
  ]
}
