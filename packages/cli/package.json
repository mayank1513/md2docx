{
  "name": "@m2d/cli",
  "author": "Mayank Kumar Chaudhari <https://mayankchaudhari.com>",
  "private": false,
  "version": "0.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/md2docx/md2docx",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/md2docx/md2docx/issues",
  "homepage": "https://github.com/md2docx/md2docx/blob/main/packages/cli/README.md",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "bin": {
    "cli": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsup": "latest",
    "typescript": "latest",
    "@turboforge/cli-kit": "latest"
  },
  "forge": {
    "aliases": [],
    "icon": "Terminal",
    "description": ""
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/md2docx"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/mayank1513"
    }
  ],
  "keywords": [
    "@m2d/cli",
    "turboforge"
  ]
}
