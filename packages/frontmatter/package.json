{
  "name": "@m2d/frontmatter",
  "author": "Mayank Kumar Chaudhari <https://mayankchaudhari.com>",
  "private": false,
  "version": "0.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Front-matter plugin for md2docx to map Markdown YAML/TOML metadata to native DOCX document properties.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/md2docx/md2docx",
    "directory": "packages/frontmatter"
  },
  "bugs": "https://github.com/md2docx/md2docx/issues",
  "homepage": "https://github.com/md2docx/md2docx/blob/main/packages/frontmatter/README.md",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@m2d/core": "workspace:*"
  },
  "peerDependencies": {
    "docx": "^9.3.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "latest",
    "docx": "^9.13.0",
    "tsup": "latest",
    "typescript": "latest"
  },
  "forge": {
    "aliases": [
      "@md2docx/frontmatter",
      "@mdast2docx/frontmatter"
    ],
    "icon": "FileText",
    "description": "Front-matter Metadata Plugin"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/md2docx"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/mayank1513"
    }
  ],
  "keywords": [
    "@m2d/frontmatter",
    "frontmatter",
    "yaml",
    "toml",
    "metadata",
    "docx",
    "markdown-to-docx",
    "mdast-to-docx",
    "md2docx",
    "mdast2docx",
    "m2d",
    "mayank1513",
    "turboforge"
  ]
}
