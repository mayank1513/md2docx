{
  "name": "@m2d/image-node",
  "author": "Mayank Kumar Chaudhari <https://mayankchaudhari.com>",
  "private": false,
  "version": "0.1.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Server-side Node.js image and SVG rasterization plugin for @m2d/core using sharp.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/md2docx/md2docx",
    "directory": "packages/image-node"
  },
  "bugs": "https://github.com/md2docx/md2docx/issues",
  "homepage": "https://github.com/md2docx/md2docx/blob/main/packages/image-node/README.md",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@m2d/core": "workspace:*",
    "@m2d/image": "workspace:*",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "docx": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "docx": "^9.12.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsup": "latest",
    "typescript": "latest",
    "unified": "^11.0.5"
  },
  "forge": {
    "aliases": [
      "@md2docx/image-node",
      "@mdast2docx/image-node"
    ],
    "icon": "Image",
    "description": "Server-Side Image Plugin"
  }
}
