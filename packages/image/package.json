{
  "name": "@m2d/image",
  "author": "Mayank Kumar Chaudhari <https://mayankchaudhari.com>",
  "private": false,
  "version": "1.5.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "MDAST to DOCX plugin for resolving and embedding images. Supports base64, URLs, and custom resolvers for seamless DOCX image integration.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./fallback": {
      "import": {
        "types": "./dist/fallback.d.mts",
        "default": "./dist/fallback.mjs"
      },
      "require": {
        "types": "./dist/fallback.d.ts",
        "default": "./dist/fallback.js"
      }
    },
    "./dist/fallback": {
      "import": {
        "types": "./dist/fallback.d.mts",
        "default": "./dist/fallback.mjs"
      },
      "require": {
        "types": "./dist/fallback.d.ts",
        "default": "./dist/fallback.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/md2docx/md2docx",
    "directory": "packages/image"
  },
  "bugs": "https://github.com/md2docx/md2docx/issues",
  "homepage": "https://github.com/md2docx/md2docx/blob/main/packages/image/README.md",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@m2d/cache": "workspace:*",
    "@m2d/core": "workspace:*",
    "@svg-fns/io": "^1.0.1",
    "@svg-fns/svg2img": "^0.2.0"
  },
  "peerDependencies": {
    "docx": "^9.3.0"
  },
  "devDependencies": {
    "@m2d/html": "workspace:*",
    "@m2d/mermaid": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "docx": "^9.12.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsup": "latest",
    "typescript": "latest",
    "unified": "^11.0.5",
    "xxhash-wasm": "^1.1.0"
  },
  "forge": {
    "aliases": [
      "@md2docx/image",
      "@mdast2docx/image"
    ],
    "icon": "Image",
    "description": "MDAST Image Resolution Plugin"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/md2docx"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/mayank1513"
    }
  ],
  "keywords": [
    "images",
    "image-plugin",
    "image-resolver",
    "image-embedding",
    "base64",
    "remote-image",
    "docx-image",
    "mdast",
    "markdown",
    "markdown-to-docx",
    "mdast-to-docx",
    "md2docx",
    "mdast2docx",
    "plugin",
    "converter",
    "remark",
    "unified",
    "docx",
    "ms-word",
    "document-generator",
    "document-generation",
    "text-processing",
    "typescript",
    "open-source",
    "customizable",
    "modern",
    "seamless-integration",
    "cutting-edge",
    "compatibility",
    "progressive",
    "web-development",
    "frontend",
    "automation",
    "export",
    "google-sheets",
    "generative-ai",
    "rich-text",
    "hyperlinks",
    "footnotes",
    "m2d",
    "mayank1513"
  ]
}
