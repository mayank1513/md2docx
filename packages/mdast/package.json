{
  "name": "@m2d/mdast",
  "author": "Mayank Kumar Chaudhari <https://mayankchaudhari.com>",
  "private": false,
  "version": "0.2.4",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Extended MDAST types and custom node data for mdast2docx with support for DOCX formatting.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./dist/utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/md2docx/md2docx",
    "directory": "packages/mdast"
  },
  "bugs": "https://github.com/md2docx/md2docx/issues",
  "homepage": "https://github.com/md2docx/md2docx/blob/main/packages/mdast/README.md",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "docx": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/unist": "^3.0.3",
    "docx": "^9.6.1",
    "mermaid": "^11.13.0",
    "tsup": "latest",
    "typescript": "latest"
  },
  "forge": {
    "aliases": [
      "@md2docx/mdast",
      "@mdast2docx/mdast"
    ],
    "icon": "Network",
    "description": "Extended MDAST Node Definitions"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/md2docx"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/mayank1513"
    }
  ],
  "keywords": [
    "mdast",
    "mdast extensions",
    "custom nodes",
    "unist custom nodes",
    "unist",
    "markdown",
    "markdown-to-docx",
    "customizable",
    "docx formatting",
    "text-processing",
    "typescript",
    "remark",
    "unified",
    "open-source",
    "web-development",
    "automation",
    "docx",
    "document generator",
    "ms-word",
    "rich text",
    "footnotes",
    "hyperlinks",
    "images",
    "mdast2docx"
  ]
}
