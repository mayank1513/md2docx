    "@m2d/html-node": "workspace:*",
    "@m2d/image-node": "workspace:*",
    "@m2d/mermaid-node": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@m2d/html-node": {
      "optional": true
    },
    "@m2d/image-node": {
      "optional": true
    },
    "@m2d/mermaid-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@m2d/html-node": "workspace:*",
    "@m2d/image-node": "workspace:*",
    "@m2d/mermaid-node": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/unist": "^3.0.3",
    "node-fetch": "^3.3.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "tsup": "latest",
    "typescript": "latest",
    "unified": "^11.0.5"
  },
  "forge": {
    "aliases": [
      "md-to-docx",
      "mdast-to-docx"
    ],
    "icon": "FileOutput",
    "description": "Complete Markdown to DOCX"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/md2docx"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/mayank1513"
    }
