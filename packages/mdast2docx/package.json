{
  "name": "mdast2docx",
  "author": "Mayank Kumar Chaudhari <https://mayankchaudhari.com>",
  "private": false,
  "version": "1.7.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Convert Markdown Abstract Syntax Tree (MDAST) to DOCX seamlessly. Supports footnotes, images, links, and customizable document properties.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./section": {
      "import": {
        "types": "./dist/section.d.mts",
        "default": "./dist/section.mjs"
      },
      "require": {
        "types": "./dist/section.d.ts",
        "default": "./dist/section.js"
      }
    },
    "./dist/section": {
      "import": {
        "types": "./dist/section.d.mts",
        "default": "./dist/section.mjs"
      },
      "require": {
        "types": "./dist/section.d.ts",
        "default": "./dist/section.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      }
    },
    "./dist/utils": {
      "import": {
        "types": "./dist/utils/index.d.mts",
        "default": "./dist/utils/index.mjs"
      },
      "require": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.js"
      }
    },
    "./cache": {
      "import": {
        "types": "./dist/utils/cache.d.mts",
        "default": "./dist/utils/cache.mjs"
      },
      "require": {
        "types": "./dist/utils/cache.d.ts",
        "default": "./dist/utils/cache.js"
      }
    },
    "./utils/cache": {
      "import": {
        "types": "./dist/utils/cache.d.mts",
        "default": "./dist/utils/cache.mjs"
      },
      "require": {
        "types": "./dist/utils/cache.d.ts",
        "default": "./dist/utils/cache.js"
      }
    },
    "./dist/utils/cache": {
      "import": {
        "types": "./dist/utils/cache.d.mts",
        "default": "./dist/utils/cache.mjs"
      },
      "require": {
        "types": "./dist/utils/cache.d.ts",
        "default": "./dist/utils/cache.js"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/plugins/index.d.mts",
        "default": "./dist/plugins/index.mjs"
      },
      "require": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.js"
      }
    },
    "./dist/plugins": {
      "import": {
        "types": "./dist/plugins/index.d.mts",
        "default": "./dist/plugins/index.mjs"
      },
      "require": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.js"
      }
    },
    "./plugins/node": {
      "import": {
        "types": "./dist/plugins/node/index.d.mts",
        "default": "./dist/plugins/node/index.mjs"
      },
      "require": {
        "types": "./dist/plugins/node/index.d.ts",
        "default": "./dist/plugins/node/index.js"
      }
    },
    "./dist/plugins/node": {
      "import": {
        "types": "./dist/plugins/node/index.d.mts",
        "default": "./dist/plugins/node/index.mjs"
      },
      "require": {
        "types": "./dist/plugins/node/index.d.ts",
        "default": "./dist/plugins/node/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/md2docx/md2docx",
    "directory": "packages/mdast2docx"
  },
  "bugs": "https://github.com/md2docx/md2docx/issues",
  "homepage": "https://github.com/md2docx/md2docx/blob/main/packages/mdast2docx/README.md",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@m2d/cache": "workspace:*",
    "@m2d/core": "workspace:*",
    "@m2d/emoji": "^0.1.3",
