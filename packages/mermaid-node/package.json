{
  "name": "@m2d/mermaid-node",
  "author": "Mayank Kumar Chaudhari <https://mayankchaudhari.com>",
  "private": false,
  "version": "0.1.3",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Server-side Node.js Mermaid diagram plugin for @m2d/core using beautiful-mermaid.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/md2docx/md2docx",
    "directory": "packages/mermaid-node"
  },
  "bugs": "https://github.com/md2docx/md2docx/issues",
  "homepage": "https://github.com/md2docx/md2docx/blob/main/packages/mermaid-node/README.md",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@m2d/core": "workspace:*",
    "beautiful-mermaid": "^1.1.3"
  },
  "peerDependencies": {
    "docx": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "docx": "^9.13.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsup": "latest",
    "typescript": "latest",
    "unified": "^11.0.5"
  },
  "forge": {
    "aliases": [
      "@md2docx/mermaid-node",
      "@mdast2docx/mermaid-node"
    ],
    "icon": "GitGraph",
    "description": "Server-Side Mermaid Plugin"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/md2docx"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/mayank1513"
    }
  ],
  "keywords": [
    "@m2d/mermaid-node",
    "mermaid",
    "diagram",
    "docx",
    "word",
    "node"
  ]
}
