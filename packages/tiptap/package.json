{
  "name": "@m2d/tiptap",
  "author": "Mayank Kumar Chaudhari <https://mayankchaudhari.com>",
  "private": false,
  "version": "0.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Tiptap extension to export rich-text editor content directly to Word (.docx) documents.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/md2docx/md2docx",
    "directory": "packages/tiptap"
  },
  "bugs": "https://github.com/md2docx/md2docx/issues",
  "homepage": "https://github.com/md2docx/md2docx/blob/main/packages/tiptap/README.md",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@m2d/core": "workspace:*",
    "@m2d/md2docx": "workspace:*"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@types/node": "latest",
    "tsup": "latest",
    "typescript": "latest"
  },
  "forge": {
    "aliases": [
      "tiptap-extension-docx",
      "@md2docx/tiptap",
      "@mdast2docx/tiptap"
    ],
    "icon": "FileDown",
    "description": "Tiptap DOCX Export Extension"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/md2docx"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/mayank1513"
    }
  ],
  "keywords": [
    "@m2d/tiptap",
    "tiptap",
    "tiptap-extension",
    "docx",
    "word",
    "export",
    "turboforge"
  ]
}
