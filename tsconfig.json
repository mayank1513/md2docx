{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Base Standards */
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],

    /* Module Resolution */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,

    /* Path Mapping */
    "paths": {
      "@m2d/core": ["./packages/core/src", "./packages/core/dist"],
      "@m2d/html": ["./packages/html/src", "./packages/html/dist"],
      "@m2d/image": ["./packages/image/src", "./packages/image/dist"],
      "@m2d/image-node": [
        "./packages/image-node/src",
        "./packages/image-node/dist"
      ],
      "@m2d/list": ["./packages/list/src", "./packages/list/dist"],
      "@m2d/math": ["./packages/math/src", "./packages/math/dist"],
      "@m2d/mdast": ["./packages/mdast/src", "./packages/mdast/dist"],
      "@m2d/mermaid": ["./packages/mermaid/src", "./packages/mermaid/dist"],
      "@m2d/mermaid-node": [
        "./packages/mermaid-node/src",
        "./packages/mermaid-node/dist"
      ],
      "@m2d/react-markdown": [
        "./packages/react-markdown/src",
        "./packages/react-markdown/dist"
      ],
      "@m2d/remark-docx": [
        "./packages/remark-docx/src",
        "./packages/remark-docx/dist"
      ],
      "@m2d/table": ["./packages/table/src", "./packages/table/dist"],
      "mdast2docx": ["./packages/mdast2docx/src", "./packages/mdast2docx/dist"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "vitest.config.ts"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/.next",
    "**/.turbo",
    "apps",
    "examples",
    "coverage"
  ]
}
